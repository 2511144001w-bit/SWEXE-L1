<%= form_with model: media_item, local: true, multipart: true, data: { turbo: false } do |form| %>
  <% if media_item.errors.any? %>
    <div class="form-errors" role="alert">
      <p>入力内容を確認してください。</p>
      <ul>
        <% media_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= form.label :title, "タイトル" %>
    <%= form.text_field :title %>
  </div>
  <div class="form-field">
    <%= form.label :creator, "作者" %>
    <%= form.text_field :creator %>
  </div>
  <div class="form-field">
    <%= form.label :description, "説明" %>
    <%= form.text_area :description, rows: 4 %>
  </div>
  <div class="form-field">
    <%= form.label :upload, "画像ファイル" %>
    <%= form.file_field :upload, accept: "image/*" %>
  </div>
  <% if media_item.persisted? %>
    <p class="field-hint">画像を選ばなければ、現在の画像を残します。</p>
  <% end %>
  <%= form.submit(media_item.persisted? ? "更新する" : "登録する", class: "primary-link") %>
<% end %>
