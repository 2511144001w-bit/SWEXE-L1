<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>画像管理</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "media_library" %>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <%= link_to "画像管理", media_items_path, class: "site-brand" %>
        <nav aria-label="メインメニュー">
          <%= link_to "一覧", media_items_path %>
          <%= link_to "新規登録", new_media_item_path %>
        </nav>
      </div>
    </header>
    <main class="main-content">
      <% if flash[:notice].present? %>
        <p class="flash flash--notice" role="status"><%= flash[:notice] %></p>
      <% end %>
      <% if flash[:alert].present? %>
        <p class="flash flash--alert" role="alert"><%= flash[:alert] %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
